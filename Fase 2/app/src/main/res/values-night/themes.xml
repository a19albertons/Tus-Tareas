<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.TusTareas" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your dark theme here. -->
        <!-- <item name="colorPrimary">@color/my_dark_primary</item> -->
    </style>

    <style name="Theme.TusTareas" parent="Base.Theme.TusTareas" />

    <!-- customización de los dialogos -->
    <style name="DialogoPersonalizado" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <!-- Color mensajes -->
        <item name="android:textColor">@color/blueNotes </item>
        <!-- Color de fondo -->
        <item name="android:background">@color/gray</item>

        <!-- Botones -->
        <item name="buttonBarPositiveButtonStyle">@style/BoronPositivo</item>
        <item name="buttonBarNegativeButtonStyle">@style/BoronNegativo</item>
        <item name="buttonBarNeutralButtonStyle">@style/BoronNeutral</item>
    </style>

    <style name="BoronPositivo" parent="Widget.Material3.Button.TextButton.Dialog">
        <!-- Color boton -->
        <item name="android:textColor">@color/black</item>
    </style>
    <style name="BoronNegativo" parent="Widget.Material3.Button.TextButton.Dialog">
        <!-- Color boton -->
        <item name="android:textColor">@color/black</item>
    </style>
    <style name="BoronNeutral" parent="Widget.Material3.Button.TextButton.Dialog">
        <!-- Color boton -->
        <item name="android:textColor">@color/black</item>
    </style>

    <!-- Gestion del bottom navigation view y su globo -->
    <style name="globoBottomNavigation" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@android:color/transparent</item>
        <item name="android:width">0dp</item>
        <item name="android:height">0dp</item>
    </style>

    <!-- Fondo blanco desplegable tareas de ordenacion por fechas -->
    <style name="fondoBlancoTareas" parent="Widget.AppCompat.PopupMenu">
        <item name="android:itemBackground">@color/gray</item>
    </style>

    <!-- Modificar los 3 puntos del toolbar -->
    <style name="modifcar3PuntosToolbar" parent="Widget.Material3.PopupMenu">
        <!-- Color del texto -->
        <item name="android:textColor">@color/black</item>
        <!-- Color de fondo -->
        <item name="android:itemBackground">@color/grayStatsToolbar</item>
    </style>
</resources>